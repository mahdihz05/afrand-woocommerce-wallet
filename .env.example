WC_BASE_URL=https://www.afrandacademy.ir
WC_STAGING_HOST=www.afrandacademy.ir
WC_ENVIRONMENT=staging
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WRITES_ENABLED=false
WC_TIMEOUT=15
WC_READ_TIMEOUT=5
PANEL_AUTH_ENABLED=true
WALLET_MODE=true
PANEL_USERNAME=demo
PANEL_PASSWORD_HASH=
# Required with panel login: independently generated random key, at least 32 bytes.
FLASK_SECRET_KEY=
PORT=5055
# Absolute, persistent local disk path, outside the web root (optional locally).
# AFRAND_DATABASE=/home/account/private/afrand/panel.sqlite3
# Enable only when the host has exactly one trusted HTTPS reverse proxy.
AFRAND_TRUST_PROXY=false
